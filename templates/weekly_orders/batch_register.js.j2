// Auto-fill row data and handle scanner input
function autoFillRow(partNumberInput) {
    const partNumber = partNumberInput.value.trim();
    const row = partNumberInput.closest('tr');
    if (partNumber) {
        fetch(`/api/part/${partNumber}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Part not found');
                }
                return response.json();
            })
            .then(data => {
                if (data.part_info) {
                    // Fill current row
                    const partNameInput = row.querySelector('input[name*="[part_name]"]');
                    partNameInput.value = data.part_info.name || '';
                    partNameInput.readOnly = true;
                    
                    row.querySelector('input[name*="[part_type]"]').value = data.part_info.type || ''; // New: populate part_type input
                    const unitInput = row.querySelector('input[name*="[unit]"]');
                    unitInput.value = data.part_info.unit || '';
                    unitInput.readOnly = true;

                    // Fetch and populate warehouse locations for the part
                    fetch(`/api/part/${partNumber}/locations`)
                        .then(response => response.json())
                        .then(locationData => {
                            const locationSelect = row.querySelector('select[name*="[warehouse_location_id]"]');
                            const locationStar = row.querySelector('.item-location-required-star');
                            
                            locationSelect.innerHTML = ''; // Clear existing options
                            
                            if (locationData.locations && locationData.locations.length > 0) {
                                // Part has locations
                                locationSelect.disabled = false;
                                locationSelect.required = true; // Make it required if locations exist
                                if (locationStar) locationStar.style.display = 'inline';
                                
                                locationSelect.add(new Option('請選擇儲位', ''));
                                locationData.locations.forEach(loc => {
                                    const option = new Option(`${loc.warehouse_name} - ${loc.location_code}`, loc.id);
                                    locationSelect.add(option);
                                });

                                // If only one location, auto-select it
                                if (locationData.locations.length === 1) {
                                    locationSelect.value = locationData.locations[0].id;
                                }
                                
                                // Handle pre-filled data (if any)
                                // This part needs to be handled carefully as prefill_data is global,
                                // but for batch, it's per item.
                                // For now, we assume prefill_data is handled by fillItemData.

                            } else {
                                // Part has no locations
                                locationSelect.disabled = true;
                                locationSelect.required = false; // Not required if no locations
                                if (locationStar) locationStar.style.display = 'none';
                                
                                const option = new Option('無指定儲位', '');
                                locationSelect.add(option);
                                locationSelect.value = '';
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching part locations:', error);
                            const locationSelect = row.querySelector('select[name*="[warehouse_location_id]"]');
                            const locationStar = row.querySelector('.item-location-required-star');
                            locationSelect.innerHTML = '<option value="">無法載入儲位</option>';
                            locationSelect.disabled = true;
                            locationSelect.required = false;
                            if (locationStar) locationStar.style.display = 'none';
                        });

                    // Add a new row and focus it for the next scan
                    addNewItem();
                    const allRows = document.querySelectorAll('#batchItemsBody tr');
                    const lastRow = allRows[allRows.length - 1];
                    if (lastRow) {
                        lastRow.querySelector('input[name*="[part_number]"]').focus();
                    }
                } else {
                    // Clear fields if part not found
                    const partNameInput = row.querySelector('input[name*="[part_name]"]');
                    partNameInput.value = '';
                    partNameInput.readOnly = true;
                    partNameInput.placeholder = '請先輸入品號';
                    
                    row.querySelector('input[name*="[part_type]"]').value = '';
                    
                    // 重置單位欄位
                    const unitInput = row.querySelector('input[name*="[unit]"]');
                    unitInput.value = '';
                    unitInput.readOnly = true;
                    unitInput.placeholder = '請先輸入品號';
                    const locationSelect = row.querySelector('select[name*="[warehouse_location_id]"]');
                    locationSelect.innerHTML = '<option value="">請先輸入有效的品號</option>';
                    locationSelect.disabled = true;
                    locationSelect.required = false;
                }
            })
            .catch(error => {
                console.error('Error fetching part details:', error);
                // Clear fields on error
                const partNameInput = row.querySelector('input[name*="[part_name]"]');
                partNameInput.value = '';
                partNameInput.readOnly = true;
                partNameInput.placeholder = '請先輸入品號';
                
                row.querySelector('input[name*="[part_type]"]').value = '';
                
                // 重置單位欄位
                const unitInput = row.querySelector('input[name*="[unit]"]');
                unitInput.value = '';
                unitInput.readOnly = true;
                unitInput.placeholder = '請先輸入品號';
                const locationSelect = row.querySelector('select[name*="[warehouse_location_id]"]');
                locationSelect.innerHTML = '<option value="">請先輸入有效的品號</option>';
                locationSelect.disabled = true;
                locationSelect.required = false;
            });
    } else {
        // Clear fields if part number is empty
        const partNameInput = row.querySelector('input[name*="[part_name]"]');
        partNameInput.value = '';
        partNameInput.readOnly = true;
        partNameInput.placeholder = '請先輸入品號';
        
        row.querySelector('input[name*="[part_type]"]').value = '';
        
        // 重置單位欄位
        const unitInput = row.querySelector('input[name*="[unit]"]');
        unitInput.value = '';
        unitInput.readOnly = true;
        unitInput.placeholder = '請先輸入品號';
        const locationSelect = row.querySelector('select[name*="[warehouse_location_id]"]');
        locationSelect.innerHTML = '<option value="">請先輸入有效的品號</option>';
        locationSelect.disabled = true;
        locationSelect.required = false;
    }
}

// ============================================================================
// 防重複訂購檢查：表單提交前攔截
// ============================================================================
(function() {
    const form = document.getElementById('batchOrderForm');
    if (!form) return;

    let pendingCheckConfirmed = false;

    form.addEventListener('submit', function(e) {
        // 如果已確認過，直接提交
        if (pendingCheckConfirmed) {
            pendingCheckConfirmed = false;
            return;
        }

        e.preventDefault();

        const rows = document.querySelectorAll('#batchItemsBody tr');
        const items = [];

        rows.forEach(row => {
            const partNumber = (row.querySelector('input[name*="[part_number]"]')?.value || '').trim();
            const locationId = row.querySelector('select[name*="[warehouse_location_id]"]')?.value || null;

            if (partNumber) {
                items.push({
                    part_number: partNumber,
                    warehouse_location_id: locationId || null
                });
            }
        });

        if (items.length === 0) {
            form.submit();
            return;
        }

        const submitBtn = document.getElementById('submitBatchOrder');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 檢查重複中...';
        }

        fetch('/api/weekly-orders/check-pending-inbound-batch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
        })
        .then(r => r.json())
        .then(data => {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> 提交批量申請';
            }

            if (!data.results || Object.keys(data.results).length === 0) {
                // 無重複，直接提交
                pendingCheckConfirmed = true;
                form.submit();
                return;
            }

            // 有重複項目，組裝警告訊息
            const duplicateKeys = Object.keys(data.results);
            let msg = `⚠️ 以下 ${duplicateKeys.length} 個品號/儲位已有待處理的訂單項目：\n\n`;

            duplicateKeys.forEach(key => {
                const result = data.results[key];
                msg += `📦 ${result.part_number} (${result.count} 筆)：\n`;
                result.items.forEach(item => {
                    msg += `   • [${item.status_text}] ${item.quantity} 個`;
                    if (item.type === 'pending_inbound') {
                        msg += ` (剩餘 ${item.remaining})`;
                    }
                    msg += ` - ${item.applicant_name}\n`;
                });
                msg += '\n';
            });

            msg += '確定要繼續提交嗎？';

            if (confirm(msg)) {
                pendingCheckConfirmed = true;
                form.submit();
            }
        })
        .catch(err => {
            console.warn('批量檢查失敗，直接提交:', err);
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> 提交批量申請';
            }
            pendingCheckConfirmed = true;
            form.submit();
        });
    });
})();
