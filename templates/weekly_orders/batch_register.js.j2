let itemCount = 0;

// 計算並顯示剩餘時間
function updateTimeRemaining() {
    const deadline = new Date('{{ current_cycle.deadline.isoformat() }}');
    const now = new Date();
    const diff = deadline - now;
    
    const timeRemainingEl = document.getElementById('timeRemaining');
    
    if (diff <= 0) {
        timeRemainingEl.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>申請已截止</span>';
        return;
    }
    
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    
    timeRemainingEl.innerHTML = '<i class="fas fa-hourglass-half me-1"></i>剩餘時間：' + days + '天 ' + hours + '小時 ' + minutes + '分鐘';
}

// 頁面載入時初始化
document.addEventListener('DOMContentLoaded', function() {
    // 優先檢查 sessionStorage 中的批量訂單數據（從庫存頁面點擊批量週期訂單按鈕）
    const batchOrderItems = sessionStorage.getItem('batchOrderItems');
    
    if (batchOrderItems) {
        try {
            const items = JSON.parse(batchOrderItems);
            if (items && items.length > 0) {
                console.log('從 sessionStorage 載入品項：', items);
                loadInventoryItems(items);
                // 清除 sessionStorage，避免重複載入
                sessionStorage.removeItem('batchOrderItems');
            }
        } catch (e) {
            console.error('解析 sessionStorage 資料失敗：', e);
        }
    } else {
        // 檢查是否有從後端傳來的預填數據
        const prefillItems = {{ prefill_items | tojson | safe }};
        
        if (prefillItems && prefillItems.length > 0) {
            // 處理從後端傳來的數據
            loadInventoryItems(prefillItems);
        } else {
            // 添加第一個空白項目
            addNewItem();
        }
    }
    
    updateTimeRemaining();
    setInterval(updateTimeRemaining, 60000); // 每分鐘更新一次
});

// 載入從庫存頁面傳來的項目
function loadInventoryItems(items) {
    items.forEach((item, index) => {
        // 添加新行
        addNewItem();
        
        // 填入數據
        setTimeout(() => {
            const row = document.querySelectorAll('#batchItemsBody tr')[index];
            if (row) {
                // 基本信息
                const partNumberInput = row.querySelector('input[name*="[part_number]"]');
                const partNameInput = row.querySelector('input[name*="[part_name]"]');
                const quantityInput = row.querySelector('input[name*="[quantity]"]');
                const unitInput = row.querySelector('input[name*="[unit]"]');
                const typeInput = row.querySelector('input[name*="[part_type]"]');
                const prioritySelect = row.querySelector('select[name*="[priority]"]');
                const notesInput = row.querySelector('input[name*="[purpose_notes]"]');
                const locationSelect = row.querySelector('select[name*="[warehouse_location_id]"]');
                
                if (partNumberInput) partNumberInput.value = item.part_number || '';
                if (partNameInput) {
                    partNameInput.value = item.part_name || '';
                    partNameInput.readOnly = true;
                }
                // 移除數量預填，讓使用者手動輸入
                // if (quantityInput) quantityInput.value = item.suggested_quantity || '';
                if (unitInput) {
                    unitInput.value = item.unit || '';
                    unitInput.readOnly = true;
                }
                if (typeInput) typeInput.value = item.part_type || '';
                
                // 設定優先級為預設值（一般），讓用戶自行決定
                if (prioritySelect) {
                    prioritySelect.value = 'normal';
                }
                
                // 自動填入備註，顯示庫存狀況
                if (notesInput) {
                    let notes = `從庫存頁面導入 - ${item.warehouse_name} ${item.location_code}`;
                    if (item.available_quantity <= 0) {
                        notes += ' (缺貨)';
                    } else if (item.available_quantity <= item.reorder_point) {
                        notes += ' (低庫存)';
                    } else {
                        notes += ' (正常)';
                    }
                    notesInput.value = notes;
                }
                
                // 設定儲位
                if (locationSelect && item.warehouse_location_id) {
                    // 先載入該零件的所有可用儲位
                    fetch(`/api/part/${item.part_number}/locations`)
                        .then(response => response.json())
                        .then(locationData => {
                            locationSelect.innerHTML = '';
                            
                            if (locationData.locations && locationData.locations.length > 0) {
                                locationSelect.disabled = false;
                                locationSelect.required = true;
                                
                                locationSelect.add(new Option('請選擇儲位', ''));
                                locationData.locations.forEach(loc => {
                                    const option = new Option(`${loc.warehouse_name} - ${loc.location_code}`, loc.id);
                                    locationSelect.add(option);
                                });
                                
                                // 自動選中原儲位
                                locationSelect.value = item.warehouse_location_id;
                            } else {
                                locationSelect.disabled = true;
                                locationSelect.required = false;
                                locationSelect.add(new Option('無指定儲位', ''));
                            }
                        })
                        .catch(error => {
                            console.error('Error loading locations:', error);
                            // 使用備用方案：直接設定選項
                            locationSelect.innerHTML = '';
                            const optionText = `${item.warehouse_name} - ${item.location_code}`;
                            locationSelect.add(new Option(optionText, item.warehouse_location_id));
                            locationSelect.value = item.warehouse_location_id;
                            locationSelect.disabled = false;
                            locationSelect.required = true;
                        });
                }
                
                // 標記行為已預填
                row.classList.add('prefilled');
                row.style.backgroundColor = '#e8f5e8';
            }
        }, index * 100); // 延遲處理避免DOM操作衝突
    });
}

// 新增項目
function addNewItem() {
    const template = document.getElementById('itemRowTemplate');
    const tbody = document.getElementById('batchItemsBody');
    const newRow = template.content.cloneNode(true);
    
    // 更新項目序號和表單名稱
    const tr = newRow.querySelector('tr');
    tr.querySelector('.item-sequence').textContent = itemCount + 1;
    
// 更新所有表單元素的 name 屬性
    const inputs = tr.querySelectorAll('input, select');
    inputs.forEach(input => {
        const name = input.getAttribute('name');
        if (name) {
            input.setAttribute('name', name.replace('[0]', `[${itemCount}]`));
        }
    });
    
    // Add event listener for barcode scanner (Enter key)
    const partNumberInput = tr.querySelector('input[name*="[part_number]"]');
    partNumberInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            event.preventDefault(); // Prevent form submission
            autoFillRow(this);
        }
    });

    tbody.appendChild(newRow);
    itemCount++;
}

// 移除項目
function removeItem(button) {
    if (itemCount <= 1) {
        alert('至少需要保留一個申請項目');
        return;
    }
    
    const row = button.closest('tr');
    row.remove();
    itemCount--;
    
    // 重新編號
    updateItemSequences();
}

// 更新項目序號
function updateItemSequences() {
    const rows = document.querySelectorAll('#batchItemsBody tr');
    rows.forEach((row, index) => {
        row.querySelector('.item-sequence').textContent = index + 1;
        
        // 更新表單名稱
        const inputs = row.querySelectorAll('input, select');
        inputs.forEach(input => {
            const name = input.getAttribute('name');
            if (name) {
                const newName = name.replace(/\[\d+\]/, `[${index}]`);
                input.setAttribute('name', newName);
            }
        });
    });
}

// 套用全域優先級
function applyGlobalPriority() {
    const globalPriority = document.getElementById('global_priority').value;
    if (globalPriority) {
        const prioritySelects = document.querySelectorAll('select[name*="[priority]"]');
        prioritySelects.forEach(select => {
            select.value = globalPriority;
        });
    }
}

// 套用全域需用日期
function applyGlobalDate() {
    const globalDate = document.getElementById('global_required_date').value;
    if (globalDate) {
        const dateInputs = document.querySelectorAll('input[name*="[required_date]"]');
        dateInputs.forEach(input => {
            input.value = globalDate;
        });
    }
}

// 填入項目資料（用於預填）
function fillItemData(index, data) {
    const row = document.querySelectorAll('#batchItemsBody tr')[index];
    if (!row) return;
    
    if (data.part_number) {
        const partNumberInput = row.querySelector('input[name*="[part_number]"]');
        partNumberInput.value = data.part_number;
        autoFillRow(partNumberInput); // Trigger auto-fill logic
    }
    if (data.part_name) {
        const partNameInput = row.querySelector('input[name*="[part_name]"]');
        partNameInput.value = data.part_name;
        partNameInput.readOnly = true;
    }
    if (data.warehouse_location_id) row.querySelector('select[name*="[warehouse_location_id]"]').value = data.warehouse_location_id; // New
    if (data.quantity) row.querySelector('input[name*="[quantity]"]').value = data.quantity;
    if (data.unit) {
        const unitInput = row.querySelector('input[name*="[unit]"]');
        unitInput.value = data.unit;
        unitInput.readOnly = true;
    }
    if (data.part_type) row.querySelector('input[name*="[part_type]"]').value = data.part_type; // New
    if (data.priority) row.querySelector('select[name*="[priority]"]').value = data.priority;
    if (data.purpose_notes) row.querySelector('input[name*="[purpose_notes]"]').value = data.purpose_notes;
}

